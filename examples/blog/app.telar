# Ejemplo: Blog personal
#
# Un blog con listado de artículos, página de detalle con ruta dinámica,
# y un formulario de contacto con validación. Cada línea de este archivo
# es sintaxis real de Telar — compílalo tú mismo para comprobarlo:
#
#   telar compilar app.telar

aplicación MiBlog
  idioma español
  dominio "https://miblog.example.com"
  tema oscuro

# El modelo describe la forma de los datos. Telar no incluye un backend —
# espera que tú sirvas estos datos en /api/articulo (ver "El problema" en
# el README para entender esta decisión de diseño).
datos Articulo
  título: texto
  contenido: texto
  fecha: fecha
  autor: texto

# Un diseño se aplica automáticamente a todas las páginas que no
# declaren uno propio — aquí lo usan todas.
diseño principal
  navbar
    título "Mi Blog"
  pie
    descripción "© 2026 Mi Blog — hecho con Telar"

# Página principal: lista de artículos
página inicio en "/"
  título "Mi Blog"
  descripción "Artículos sobre tecnología y diseño, sin relleno"

  mostrar Articulo recientes
    máximo 10
    ordenados por fecha
    si falla
      mostrar "No se pudieron cargar los artículos."
      reintentar en 10 segundos

# Detalle de un artículo — ruta dinámica. Un único archivo compilado
# (articulo-id.html) atiende cualquier /articulo/<lo-que-sea>; el id real
# se lee de la URL en el navegador y se usa para pedir el artículo exacto.
página articulo en "/articulo/(id)"
  diseño principal
  título "Artículo"
  mostrar Articulo según id = parametro.id

# Contacto, con validación real: si el correo no es válido o falta el
# mensaje, el navegador bloquea el envío antes de llegar a ninguna
# petición.
página contacto en "/contacto"
  diseño principal
  título "Contacto"
  descripción "¿Alguna pregunta? Escríbeme."

  campo "Tu nombre" texto requerido
  campo "Tu correo" email requerido
  campo "Mensaje" área de texto requerido máximo 500 caracteres

  botón "Enviar" enviar
    si falla
      mostrar "No se pudo enviar. Inténtalo de nuevo."
