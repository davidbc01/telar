# Ejemplo: Tienda online
#
# Listado de productos, detalle con ruta dinámica, un selector de cantidad
# con estado local, y un botón para alternar el tema. Como el del blog,
# este archivo compila tal cual — pruébalo:
#
#   telar compilar app.telar

aplicación MiTienda
  idioma español
  dominio "https://mitienda.example.com"

datos Producto
  nombre: texto
  precio: número
  imagen: foto
  descripción: texto
  stock: número

diseño principal
  navbar
    título "MiTienda"
  pie
    descripción "© 2026 MiTienda"

# Página de inicio: catálogo + botón para alternar el tema visual
página inicio en "/"
  imagen "https://mitienda.example.com/portada.jpg"
  título "Bienvenido a MiTienda"
  descripción "Los mejores productos al mejor precio"

  botón "🌙 Cambiar tema" hacer cambiar tema

  mostrar Producto recientes
    máximo 8
    ordenados por precio
    si falla
      mostrar "No se pudieron cargar los productos."
      reintentar en 10 segundos

  optimizar para móvil
  caché 5 minutos

# Detalle de producto — ruta dinámica, con un selector de cantidad que
# vive enteramente en el navegador (no hace ninguna petición al sumar o
# restar, solo actualiza lo que se ve en pantalla)
página detalle en "/producto/(id)"
  diseño principal
  título "Producto"

  mostrar Producto filtrados por id = parametro.id

  variable cantidad = 1
  texto cantidad
  botón "+" hacer sumar cantidad
  botón "−" hacer restar cantidad

  botón "Añadir al carrito" hacer añadirAlCarrito
    si falla
      mostrar "No se pudo añadir. Inténtalo de nuevo."

# Login, con validación real en ambos campos
página login en "/entrar"
  diseño principal
  título "Entrar"

  campo "Correo electrónico" tipo email requerido
  campo "Contraseña" tipo contraseña requerido mínimo 8

  botón "Entrar" hacer iniciarSesion
    si falla
      mostrar "Correo o contraseña incorrectos"
